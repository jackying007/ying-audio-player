{
  "dev": {
    "ip": "0.0.0.0",
    "port": 8787
  },
  "name": "ying-audio-player",
  "main": "src/main.ts",
  "compatibility_date": "2026-10-18",
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "ying-audio-player",
      "database_id": "67f2a6cc-0a58-4814-ac31-717e4927be64",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "ying-audio-player"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}
