{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "local-audio:allow-list-folders",
    "local-audio:allow-import-folder",
    "local-audio:allow-list-audios",
    "local-audio:allow-refresh-folder",
    "local-audio:allow-remove-folder",
    "network-cache:allow-read-cache",
    "network-cache:allow-save-cache",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    "fs:allow-read-file",
    "fs:allow-read-text-file"
  ]
}
